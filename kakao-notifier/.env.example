# Kakao Developers app credentials. Copy this file to .env and fill real values.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4000/oauth/callback
KAKAO_TOKEN_FILE=data/kakao-token.json

# Optional fallback used only by the compatibility image-send path.
KAKAO_IMAGE_BASE_URL=

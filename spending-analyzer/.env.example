# 이 파일을 .env로 복사해서 값을 채우세요. .env는 커밋되지 않습니다.

# Gmail 앱 비밀번호 (계정 비밀번호가 아닙니다).
# Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호에서 발급합니다.
GMAIL_USER=본인주소@gmail.com
GMAIL_APP_PASSWORD=앱비밀번호16자리

# 명세서 PDF에 암호가 걸려 있을 때만 필요합니다.
# 걸려 있는지는 `python -m spending_analyzer scan-mail`이 알려줍니다.
SAMSUNG_PDF_PASSWORD=

# 미분류 가맹점 자동 분류용 (선택). 없으면 그 단계만 건너뜁니다.
ANTHROPIC_API_KEY=

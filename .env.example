# Copy this file to .env at the repo root and fill in the real value.
# Shared by real-estate-finder (Kakao card/text links) and, indirectly, by
# report-site's .env (which holds the path token embedded in this URL).
# Set after Tailscale Funnel is up: see .docs/RUNBOOK.md.
#KAKAO_REPORT_URL=https://<pc>.<tailnet>.ts.net/property/report/

# Naver sign-in, used only when the browser is signed out. The 06:00 health
# check (`check-login`) signs in with these instead of only warning; leave them
# out and it warns, and browser-login still lets you sign in by hand.
# Quote the password if it has spaces or a leading #.
#NAVER_ID=<naver id>
#NAVER_PASSWORD=<naver password>

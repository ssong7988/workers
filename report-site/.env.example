# Copy this file to .env and fill in real values. Never commit .env.

# The unguessable path prefix the report and the admin live under.
# Generate one with: python -c "import secrets; print(secrets.token_hex(16))"
REPORT_PATH_TOKEN=REPLACE_WITH_AN_UNGUESSABLE_HEX_TOKEN

# Bearer token real-estate-finder sends to /api/. Same generator.
# The site is reachable from the internet through Tailscale Funnel, so
# this is the only thing keeping the scan endpoint closed.
FINDER_API_TOKEN=REPLACE_WITH_A_DIFFERENT_UNGUESSABLE_HEX_TOKEN

# PostgreSQL. Only the password has no usable default.
POSTGRES_PASSWORD=REPLACE_WITH_THE_DATABASE_PASSWORD
# POSTGRES_DB=property_report
# POSTGRES_USER=property_report
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

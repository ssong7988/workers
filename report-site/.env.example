# Copy this file to .env and fill in real values. Never commit .env.

# The unguessable path prefix the report and the admin live under.
# Generate one with: python -c "import secrets; print(secrets.token_hex(16))"
REPORT_PATH_TOKEN=REPLACE_WITH_AN_UNGUESSABLE_HEX_TOKEN

# Bearer token real-estate-finder sends to /api/. Same generator.
# The site is reachable from the internet through Tailscale Funnel, so
# this is the only thing keeping the scan endpoint closed.
FINDER_API_TOKEN=REPLACE_WITH_A_DIFFERENT_UNGUESSABLE_HEX_TOKEN

# PostgreSQL. Only the password has no usable default.
POSTGRES_PASSWORD=REPLACE_WITH_THE_DATABASE_PASSWORD
# POSTGRES_DB=property_report
# POSTGRES_USER=property_report
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Airflow (runs in WSL2; see .agent/PROJECT_STATE.md, "Planned Work: Airflow로
# 스케줄 이관"). All optional - the r/<TOKEN>/airflow/ screen just says "not
# configured" when these are unset. WSL2 forwards its ports to
# 127.0.0.1 on the Windows side, so the default webserver address works as-is.
# AIRFLOW_API_URL=http://127.0.0.1:8080
# AIRFLOW_USERNAME=admin
# AIRFLOW_PASSWORD=REPLACE_WITH_THE_AIRFLOW_PASSWORD
# Alternative to USERNAME/PASSWORD: a pre-issued JWT, skips the /auth/token call.
# AIRFLOW_API_TOKEN=
# AIRFLOW_TIMEOUT_SECONDS=5

# Dagster (dagster_project/, its own venv; see .agent/PROJECT_STATE.md,
# "Active Work: Dagster로 스케줄 구동") drives the schedule for now, natively
# on this machine - no WSL. Both have a working default already (run-dagster.ps1
# binds 127.0.0.1:3000 at /url/dagster), so neither needs to be set for the
# common case.
# DAGSTER_GRAPHQL_URL=http://127.0.0.1:3000/url/dagster/graphql
# DAGSTER_TIMEOUT_SECONDS=5
